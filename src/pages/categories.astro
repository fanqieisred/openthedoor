---
import { getCollection } from 'astro:content';

export const prerender = true;

const posts = await getCollection('posts');
const sortedPosts = posts.sort((a, b) => (b.data.date || '').localeCompare(a.data.date || ''));

const categories = {
  'medical-research': { name: '医疗科研', emoji: '🔬', color: 'blue' },
  'medical-trends': { name: '医疗前瞻', emoji: '🔮', color: 'purple' },
  'medical-insights': { name: '行业洞察', emoji: '💡', color: 'green' },
  'medical-tech': { name: '技术解析', emoji: '⚙️', color: 'orange' },
};

const categoryPosts: Record<string, typeof sortedPosts> = {};
for (const cat of Object.keys(categories)) {
  categoryPosts[cat] = sortedPosts.filter(p => p.data.category === cat);
}
---

<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>分类 - OpenTheDoor</title>
</head>
<body class="bg-gray-50 text-gray-900">
  <header class="bg-white shadow">
    <nav class="max-w-6xl mx-auto px-4 py-4 flex justify-between items-center">
      <a href="/" class="text-xl font-bold">OpenTheDoor</a>
      <div class="space-x-4">
        <a href="/" class="hover:text-blue-600">首页</a>
        <a href="/categories" class="hover:text-blue-600">分类</a>
        <a href="/about" class="hover:text-blue-600">关于</a>
      </div>
    </nav>
  </header>

  <main class="max-w-6xl mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-8">文章分类</h1>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {Object.entries(categories).map(([key, cat]) => (
        <a href={`/categories/${key}`} class="block bg-white p-6 rounded-lg shadow hover:shadow-lg transition">
          <div class="flex items-center justify-between">
            <div>
              <h2 class="text-2xl font-bold">{cat.emoji} {cat.name}</h2>
              <p class="text-gray-500 mt-1">{categoryPosts[key]?.length || 0} 篇文章</p>
            </div>
            <span class="text-4xl">{cat.emoji}</span>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-12">
      <h2 class="text-2xl font-bold mb-6">最新文章</h2>
      <div class="space-y-4">
        {sortedPosts.slice(0, 5).map(post => (
          <a href={`/posts/${post.id}`} class="block bg-white p-4 rounded-lg shadow hover:shadow-md transition">
            <div class="flex items-center justify-between">
              <div>
                <h3 class="font-bold">{post.data.title}</h3>
                <p class="text-sm text-gray-500">{post.data.date || '无日期'} · {categories[post.data.category as keyof typeof categories]?.name || '医疗科研'}</p>
              </div>
              <span class="text-2xl">{post.data.emoji || '📄'}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </main>

  <footer class="bg-gray-900 text-white mt-12 py-8">
    <div class="max-w-6xl mx-auto px-4 text-center">
      <p>&copy; 2026 OpenTheDoor. All rights reserved.</p>
    </div>
  </footer>
</body>
</html>
