---
import { getCollection } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  return [
    { params: { category: 'medical-research' } },
    { params: { category: 'medical-trends' } },
    { params: { category: 'medical-insights' } },
    { params: { category: 'medical-tech' } },
  ];
}

interface PageProps {
  params: { category: string };
}

const { category } = Astro.params;

const categories = {
  'medical-research': { name: '医疗科研', emoji: '🔬' },
  'medical-trends': { name: '医疗前瞻', emoji: '🔮' },
  'medical-insights': { name: '行业洞察', emoji: '💡' },
  'medical-tech': { name: '技术解析', emoji: '⚙️' },
};

const posts = await getCollection('posts');
const filteredPosts = posts.filter(p => p.data.category === category).sort((a, b) => (b.data.date || '').localeCompare(a.data.date || ''));
---

<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{categories[category as keyof typeof categories]?.name || category} - OpenTheDoor</title>
</head>
<body class="bg-gray-50 text-gray-900">
  <header class="bg-white shadow">
    <nav class="max-w-6xl mx-auto px-4 py-4 flex justify-between items-center">
      <a href="/" class="text-xl font-bold">OpenTheDoor</a>
      <div class="space-x-4">
        <a href="/" class="hover:text-blue-600">首页</a>
        <a href="/categories" class="hover:text-blue-600">分类</a>
        <a href="/about" class="hover:text-blue-600">关于</a>
      </div>
    </nav>
  </header>

  <main class="max-w-6xl mx-auto px-4 py-8">
    <div class="mb-8">
      <h1 class="text-3xl font-bold">{categories[category as keyof typeof categories]?.emoji} {categories[category as keyof typeof categories]?.name}</h1>
      <p class="text-gray-600 mt-2">{filteredPosts.length} 篇文章</p>
    </div>

    <div class="space-y-4">
      {filteredPosts.map(post => (
        <a href={`/posts/${post.id}`} class="block bg-white p-6 rounded-lg shadow hover:shadow-lg transition">
          <div class="flex items-start justify-between">
            <div class="flex-1">
              <h2 class="text-xl font-bold mb-2">{post.data.title}</h2>
              <p class="text-sm text-gray-500 mb-3">{post.data.date || '无日期'}</p>
              <div class="flex flex-wrap gap-2">
                {(post.data.tags || []).map((tag: string) => (
                  <span class="px-2 py-1 bg-gray-100 text-gray-600 rounded text-xs">{tag}</span>
                ))}
              </div>
            </div>
            <span class="text-3xl ml-4">{post.data.emoji || '📄'}</span>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-8">
      <a href="/categories" class="text-blue-600 hover:underline">← 返回分类列表</a>
    </div>
  </main>

  <footer class="bg-gray-900 text-white mt-12 py-8">
    <div class="max-w-6xl mx-auto px-4 text-center">
      <p>&copy; 2026 OpenTheDoor. All rights reserved.</p>
    </div>
  </footer>
</body>
</html>
