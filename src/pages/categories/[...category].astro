---
import { allSlugs, articleMeta, categoryMap } from '../../lib/routes.js';

export const prerender = true;

export async function getStaticPaths() {
  return ['medical-research', 'medical-trends', 'medical-insights', 'medical-tech'].map(cat => ({
    params: { category: cat },
  }));
}

const catKey = Astro.params.category;
const categories = {
  'medical-research': { name: '医疗科研', emoji: '🔬', color: '#3b82f6' },
  'medical-trends': { name: '医疗前瞻', emoji: '🔮', color: '#8b5cf6' },
  'medical-insights': { name: '行业洞察', emoji: '💡', color: '#10b981' },
  'medical-tech': { name: '技术解析', emoji: '⚙️', color: '#f97316' },
};
const catInfo = categories[catKey] || { name: catKey, color: '#6b7280' };
---

<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{catInfo.name} - OpenTheDoor</title>
  <meta name="description" content={`${catInfo.name} 文章`} />
</head>
<body class="bg-gray-50 text-gray-900">
  <header class="bg-white shadow">
    <nav class="max-w-6xl mx-auto px-4 py-4 flex justify-between items-center">
      <a href="/" class="text-xl font-bold">OpenTheDoor</a>
      <div class="space-x-4">
        <a href="/" class="hover:text-blue-600">首页</a>
        <a href="/categories" class="hover:text-blue-600">分类</a>
        <a href="/about" class="hover:text-blue-600">关于</a>
      </div>
    </nav>
  </header>

  <main class="max-w-6xl mx-auto px-4 py-8">
    <div class="mb-6">
      <a href="/categories" class="text-blue-600 hover:underline text-sm">← 返回分类</a>
    </div>
    <h1 class="text-3xl font-bold mb-8">{catInfo.emoji} {catInfo.name}</h1>
    <div class="space-y-4">
      {allSlugs.map(slug => {
        const article = articleMeta[slug];
        if (!article || article.category !== catKey) return null;
        return (
          <a href={`/posts/${slug}`} class="bg-white p-4 rounded-lg shadow hover:shadow-md transition flex items-center gap-4">
            <span class="text-2xl">{article.emoji}</span>
            <div class="flex-1 min-w-0">
              <p class="font-medium truncate">{article.title}</p>
              <p class="text-sm text-gray-500">{article.date}</p>
            </div>
          </a>
        );
      })}
    </div>
  </main>

  <footer class="bg-gray-900 text-white mt-12 py-8">
    <div class="max-w-6xl mx-auto px-4 text-center">
      <p>&copy; 2026 OpenTheDoor. All rights reserved.</p>
    </div>
  </footer>
</body>
</html>
