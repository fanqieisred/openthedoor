---
import { allSlugs, articleMeta } from '../../lib/routes.js';

export const prerender = true;

export async function getStaticPaths() {
  return allSlugs.map(slug => ({
    params: { slug },
  }));
}

const slug = Astro.params.slug;
const article = articleMeta[slug];
if (!article) {
  throw new Error(`Article not found: ${slug}`);
}
---

<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{article.title} - OpenTheDoor</title>
  <meta name="description" content={article.title} />
</head>
<body class="bg-gray-50 text-gray-900">
  <header class="bg-white shadow">
    <nav class="max-w-6xl mx-auto px-4 py-4 flex justify-between items-center">
      <a href="/" class="text-xl font-bold">OpenTheDoor</a>
      <div class="space-x-4">
        <a href="/" class="hover:text-blue-600">首页</a>
        <a href="/categories" class="hover:text-blue-600">分类</a>
        <a href="/about" class="hover:text-blue-600">关于</a>
      </div>
    </nav>
  </header>

  <main class="max-w-6xl mx-auto px-4 py-8 grid grid-cols-1 lg:grid-cols-4 gap-8">
    <div class="lg:col-span-3">
      <article class="bg-white p-8 rounded-lg shadow">
        <div class="mb-4">
          <span class="inline-block px-3 py-1 rounded-full text-sm font-medium text-white" style="background: {article.color === 'blue' ? '#3b82f6' : article.color === 'green' ? '#10b981' : article.color === 'purple' ? '#8b5cf6' : '#f97316'}">
            {article.category}
          </span>
          <span class="text-gray-500 text-sm ml-4">{article.date}</span>
        </div>
        <h1 class="text-3xl font-bold mb-6">{article.title}</h1>
        <div class="flex flex-wrap gap-2 mb-6">
          {article.tags.map(tag => (
            <span class="px-2 py-1 bg-gray-100 text-gray-600 rounded text-sm">{tag}</span>
          ))}
        </div>
        <div class="prose max-w-none">
          <p class="text-gray-600">文章正文加载中...</p>
        </div>
      </article>
    </div>
    <div class="lg:col-span-1">
      <div class="bg-white rounded-lg shadow p-4 sticky top-4">
        <h3 class="font-semibold mb-3">本文分类</h3>
        <a href="/categories" class="block px-3 py-2 rounded bg-gray-50 hover:bg-gray-100 text-sm">
          返回分类列表
        </a>
      </div>
    </div>
  </main>

  <footer class="bg-gray-900 text-white mt-12 py-8">
    <div class="max-w-6xl mx-auto px-4 text-center">
      <p>&copy; 2026 OpenTheDoor. All rights reserved.</p>
    </div>
  </footer>
</body>
</html>
