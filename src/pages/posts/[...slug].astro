---
import { readFileSync } from 'fs';
import { resolve } from 'path';
import { marked } from 'marked';

export const prerender = true;

export async function getStaticPaths() {
  const allSlugs = ["00-每日文章汇总-2026-08-09", "01-大语言模型作为健康信息工具患者在耳鼻喉科的使用与信任研究", "02-ai在感染性疾病决策中的应用从床旁咨询到复杂护理", "03-rsna肺栓塞检测挑战赛top2模型外部验证泛化能力评估", "04-ai在肾肿块检测、特征表征与管理中的应用叙事性综述", "05-数字病理ai助力mash纤维化定量评估需求进展与挑战", "06-医疗ai-2026从技术突破走向临床落地"];
  return allSlugs.map(slug => ({
    params: { slug },
  }));
}

const slug = Astro.params.slug;
const filePath = resolve('src/content/posts', `${slug}.md`);

let articleMeta: any = null;
let articleBody = '';

try {
  const content = readFileSync(filePath, 'utf-8');
  
  // Parse frontmatter
  const fmMatch = content.match(/^---\n([\s\S]*?)\n---\n([\s\S]*)$/);
  if (fmMatch) {
    const fm = fmMatch[1];
    articleBody = fmMatch[2];
    
    // Extract fields
    const titleMatch = fm.match(/^title:\s*(.+)$/m);
    const dateMatch = fm.match(/^date:\s*(.+)$/m);
    const categoryMatch = fm.match(/^category:\s*(.+)$/m);
    const emojiMatch = fm.match(/^emoji:\s*(.+)$/m);
    
    const tags: string[] = [];
    const tagsMatch = fm.match(/^tags:\n(.*?)\n/s);
    if (tagsMatch) {
      tagsMatch[1].split('\n').forEach((line: string) => {
        const tag = line.replace(/^\s*-\s*/, '').trim();
        if (tag) tags.push(tag);
      });
    }
    
    articleMeta = {
      title: titleMatch ? titleMatch[1].trim() : slug,
      date: dateMatch ? dateMatch[1].trim() : '',
      category: categoryMatch ? categoryMatch[1].trim() : 'medical-research',
      emoji: emojiMatch ? emojiMatch[1].trim() : '📄',
      tags,
    };
    
    // Convert markdown to HTML
    articleBody = marked(articleBody);
  }
} catch (e) {
  console.error(`Error reading article ${slug}:`, e);
}

if (!articleMeta) {
  return Astro.redirect('/404');
}
---

<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{articleMeta.title} - OpenTheDoor</title>
  <meta name="description" content={articleMeta.title} />
</head>
<body class="bg-gray-50 text-gray-900">
  <header class="bg-white shadow">
    <nav class="max-w-6xl mx-auto px-4 py-4 flex justify-between items-center">
      <a href="/" class="text-xl font-bold">OpenTheDoor</a>
      <div class="space-x-4">
        <a href="/" class="hover:text-blue-600">首页</a>
        <a href="/categories" class="hover:text-blue-600">分类</a>
        <a href="/about" class="hover:text-blue-600">关于</a>
      </div>
    </nav>
  </header>

  <main class="max-w-4xl mx-auto px-4 py-8">
    <article class="bg-white p-8 rounded-lg shadow">
      <div class="mb-4">
        <span class="inline-block px-3 py-1 rounded-full text-sm font-medium text-white bg-blue-600">
          {articleMeta.category === 'medical-research' ? '医疗科研' : articleMeta.category === 'medical-trends' ? '医疗前瞻' : '医疗科研'}
        </span>
        <span class="text-gray-500 text-sm ml-4">{articleMeta.date}</span>
      </div>
      <h1 class="text-3xl font-bold mb-6">{articleMeta.title}</h1>
      <div class="flex flex-wrap gap-2 mb-6">
        {articleMeta.tags.map((tag: string) => (
          <span class="px-2 py-1 bg-gray-100 text-gray-600 rounded text-sm">{tag}</span>
        ))}
      </div>
      <div class="prose max-w-none" set:html={articleBody} />
    </article>

    <div class="mt-8">
      <a href="/categories" class="text-blue-600 hover:underline">← 返回分类列表</a>
    </div>
  </main>

  <footer class="bg-gray-900 text-white mt-12 py-8">
    <div class="max-w-6xl mx-auto px-4 text-center">
      <p>&copy; 2026 OpenTheDoor. All rights reserved.</p>
    </div>
  </footer>
</body>
</html>
