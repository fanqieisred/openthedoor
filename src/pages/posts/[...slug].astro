---
import { getCollection } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(post => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

interface PageProps {
  post: any;
}

const { post } = Astro.props;
const { data } = post;
---

<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{data.title} - OpenTheDoor</title>
  <meta name="description" content={data.title} />
</head>
<body class="bg-gray-50 text-gray-900">
  <header class="bg-white shadow">
    <nav class="max-w-6xl mx-auto px-4 py-4 flex justify-between items-center">
      <a href="/" class="text-xl font-bold">OpenTheDoor</a>
      <div class="space-x-4">
        <a href="/" class="hover:text-blue-600">首页</a>
        <a href="/categories" class="hover:text-blue-600">分类</a>
        <a href="/about" class="hover:text-blue-600">关于</a>
      </div>
    </nav>
  </header>

  <main class="max-w-4xl mx-auto px-4 py-8">
    <article class="bg-white p-8 rounded-lg shadow">
      <div class="mb-4">
        <span class="inline-block px-3 py-1 rounded-full text-sm font-medium text-white bg-blue-600">
          {data.category || '医疗科研'}
        </span>
        <span class="text-gray-500 text-sm ml-4">{data.date || '无日期'}</span>
      </div>
      <h1 class="text-3xl font-bold mb-6">{data.title}</h1>
      <div class="flex flex-wrap gap-2 mb-6">
        {(data.tags || []).map((tag: string) => (
          <span class="px-2 py-1 bg-gray-100 text-gray-600 rounded text-sm">{tag}</span>
        ))}
      </div>
      <div class="prose max-w-none">
        {post.body}
      </div>
    </article>

    <div class="mt-8">
      <a href="/categories" class="text-blue-600 hover:underline">← 返回分类列表</a>
    </div>
  </main>

  <footer class="bg-gray-900 text-white mt-12 py-8">
    <div class="max-w-6xl mx-auto px-4 text-center">
      <p>&copy; 2026 OpenTheDoor. All rights reserved.</p>
    </div>
  </footer>
</body>
</html>
