---
import { getCollection } from 'astro:content';

export const prerender = true;

const posts = await getCollection('posts');
const sortedPosts = posts.sort((a, b) => (b.data.date || '0').localeCompare(a.data.date || '0'));
---

<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>OpenTheDoor - 医疗AI博客</title>
  <meta name="description" content="医疗AI领域的科研成果与发展前瞻" />
</head>
<body class="bg-gray-50 text-gray-900">
  <header class="bg-white shadow">
    <nav class="max-w-6xl mx-auto px-4 py-4 flex justify-between items-center">
      <a href="/" class="text-xl font-bold">OpenTheDoor</a>
      <div class="space-x-4">
        <a href="/" class="hover:text-blue-600">首页</a>
        <a href="/categories" class="hover:text-blue-600">分类</a>
        <a href="/about" class="hover:text-blue-600">关于</a>
      </div>
    </nav>
  </header>

  <main class="max-w-6xl mx-auto px-4 py-8">
    <div class="mb-8">
      <h1 class="text-4xl font-bold mb-4">医疗AI博客</h1>
      <p class="text-gray-600">汇聚医疗人工智能领域的最新科研成果与发展前瞻</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {sortedPosts.map(post => (
        <a href={`/posts/${post.id}`} class="block bg-white p-6 rounded-lg shadow hover:shadow-lg transition">
          <div class="flex items-center justify-between mb-3">
            <span class="text-2xl">{post.data.emoji || '📄'}</span>
            <span class="text-sm text-gray-500">{post.data.date || '无日期'}</span>
          </div>
          <h2 class="text-xl font-bold mb-2">{post.data.title}</h2>
          <div class="flex flex-wrap gap-2">
            {(post.data.tags || []).slice(0, 3).map((tag: string) => (
              <span class="px-2 py-1 bg-blue-100 text-blue-700 rounded text-xs">{tag}</span>
            ))}
          </div>
        </a>
      ))}
    </div>
  </main>

  <footer class="bg-gray-900 text-white mt-12 py-8">
    <div class="max-w-6xl mx-auto px-4 text-center">
      <p>&copy; 2026 OpenTheDoor. All rights reserved.</p>
    </div>
  </footer>
</body>
</html>
